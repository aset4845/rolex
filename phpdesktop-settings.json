{
    "application": {
        "main_url": "http://127.0.0.1:54007/install.php",
        "web_server": "127.0.0.1:54007",
        "single_instance_application": true
    },
    "chrome": {
        "cache_path": "webcache/",
        "log_file": "debug.log",
        "log_severity": "info",
        "remote_debugging_port": 0,
        "command_line_switches": {
            "disable-web-security": "",
            "allow-file-access-from-files": "",
            "enable-local-storage": ""
        }
    },
    "main_window": {
        "title": "Rolex Shop",
        "default_size": [1200, 800],
        "minimum_size": [800, 600],
        "maximum_size": [0, 0],
        "disable_maximize_button": false,
        "center_on_screen": true,
        "start_maximized": false,
        "start_fullscreen": false
    },
    "popup_window": {
        "default_size": [800, 600],
        "minimum_size": [400, 300]
    },
    "web_server": {
        "listen_on": ["127.0.0.1", 54007],
        "www_directory": "www/",
        "index_files": ["index.php", "index.html"],
        "cgi_interpreter": "php/php-cgi.exe",
        "cgi_extensions": ["php"],
        "cgi_temp_dir": "",
        "404_handler": "/404.html"
    },
    "debugging": {
        "show_console": true,
        "subprocess_show_console": true,
        "log_level": "DEBUG",
        "log_file": "debug.log"
    }
}
