# Rolex ЖШС - Apache конфигурациясы

# Қатені көрсету (өндірісте өшіріңіз)
php_flag display_errors On
php_value error_reporting E_ALL

# UTF-8 кодтауы
AddDefaultCharset UTF-8

# Кэштеу
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# GZIP сығымдау
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript
</IfModule>

# Қауіпсіздік - папкаларды көрсетпеу
Options -Indexes

# Қауіпсіздік - .htaccess файлына қол жетімсіздік
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Қауіпсіздік - конфигурация файлдарына қол жетімсіздік
<FilesMatch "^(database\.sql|composer\.json|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>
